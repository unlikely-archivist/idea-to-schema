{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "idea-to-schema",
	"main": "src/worker.ts",
	"compatibility_date": "2026-11-25",
	// The site lives at idea-to-schema.<subdomain>.workers.dev. Per-version preview URLs are off.
	"workers_dev": true,
	"preview_urls": false,
	// pg needs Node's net and tls modules.
	"compatibility_flags": [
		"nodejs_compat"
	],
	// The built page is served as static files; only /api/* runs the Worker.
	"assets": {
		"directory": "../web/dist",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "a614312de05b4b79ba015ffe3ebc22c5"
		}
	],
	// 10 POST requests per minute per IP. Counts are kept per Cloudflare location, so they're approximate.
	"ratelimits": [
		{
			"name": "RATE_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 10,
				"period": 60
			}
		}
	]
}