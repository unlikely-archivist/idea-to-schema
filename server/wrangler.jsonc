{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "idea-to-schema",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-25",
  // pg needs Node's net and tls modules.
  "compatibility_flags": ["nodejs_compat"],
  // The built page is served as static files; only /api/* runs the Worker.
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "REPLACE_WITH_HYPERDRIVE_ID"
    }
  ],
  // 10 POST requests per minute per IP. Counts are kept per Cloudflare location, so they're approximate.
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ]
}
